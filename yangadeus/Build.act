name = "yangadeus"
fingerprint = 0xad7e530868bd0079

# stratoweave (DeviceMgr / NETCONF adapter / device_meta_config) follows the
# spec's pin, so every project in the repo builds against one platform
# revision; yang in turn follows the one stratoweave selects. midi (midiact
# bindings) is pinned here because nothing else uses it. For local hacking,
# override with:
#   acton build --dep yang=/abs/path/to/acton-yang
dependencies = {
    "midi": (
        repo_url="https://github.com/plajjan/midiact.git",
        url="https://github.com/plajjan/midiact/archive/d89334a909d83f302d8cbe201ca7d530fb31083d.zip",
        hash="N-V-__8AAFLgAAC7Vo-gRhUqO8CuNbqnab5wpcnRCVURLyJt"
    ),
    "spec": (
        path="../spec"
    ),
    "stratoweave": (
        follows="spec.stratoweave"
    ),
    "yang": (
        follows="stratoweave.yang"
    )
}
zig_dependencies = {}
